{
  "manifest_version": 3,
  "name": "Lagom Lens",
  "version": "0.1.0",
  "description": "Hover over Swedish subtitles on YouTube and SVT Play to see an English translation.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.svtplay.se/*",
    "https://api.mymemory.translated.net/*",
    "https://api-free.deepl.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["src/common.js", "src/sites/youtube.js", "src/content.js"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.svtplay.se/*"],
      "js": ["src/common.js", "src/sites/svtplay.js", "src/content.js"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Lagom Lens"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{948d675c-afb2-11f1-b390-70d823f675f2}",
      "strict_min_version": "109.0"
    }
  }
}
